{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run format:*)",
      "Bash(npm run test:*)",
      "Bash(npm run build:*)",
      "Bash(npm run db:start:*)",
      "Bash(npm run db:stop:*)",
      "Bash(npm run db:reset:*)",
      "Bash(npm run db:types:*)",
      "Bash(npx supabase status:*)",
      "Bash(npx supabase start:*)",
      "Bash(npx supabase stop:*)",
      "Bash(npx supabase db reset:*)",
      "Bash(npx supabase test db:*)",
      "Bash(npx supabase migration new:*)",
      "Bash(npx supabase migration list --local:*)",
      "Bash(npx supabase gen types typescript --local:*)",
      "Bash(npx vitest:*)",
      "Bash(npx playwright test:*)",
      "Bash(npx prettier:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(npx supabase db push:*)",
      "Bash(supabase db push:*)",
      "Bash(npx supabase migration repair:*)",
      "Bash(supabase migration repair:*)",
      "Bash(npm install:*)",
      "Bash(npm i :*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.staging)",
      "Read(./.env.production)",
      "Read(./.env.test)",
      "Read(./supabase/.env)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.*.local)",
      "Edit(./.env.production)",
      "Bash(npx supabase link:*)",
      "Bash(supabase link:*)",
      "Bash(npx supabase db push --linked:*)",
      "Bash(supabase db push --linked:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf:*)",
      "Bash(vercel:*)",
      "Bash(npx vercel:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob|Bash|PowerShell",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\"" }]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-migrations.mjs\"" }]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit.mjs\"", "timeout": 300 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.mjs\"" }]
      }
    ]
  }
}
