{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm run test)",
      "Bash(npm run test:unit)",
      "Bash(npm run test:db)",
      "Bash(npm run test:e2e)",
      "Bash(npm run build)",
      "Bash(npm run db:start)",
      "Bash(npm run db:stop)",
      "Bash(npm run db:reset)",
      "Bash(npm run db:types)",
      "Bash(npx supabase status:*)",
      "Bash(npx supabase start:*)",
      "Bash(npx supabase stop:*)",
      "Bash(npx supabase db reset:*)",
      "Bash(npx supabase test db:*)",
      "Bash(npx supabase migration new:*)",
      "Bash(npx supabase migration list --local:*)",
      "Bash(npx supabase gen types typescript --local:*)",
      "Bash(npx vitest:*)",
      "Bash(npx playwright test:*)",
      "Bash(npx prettier:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list:*)",
      "mcp__supabase-local__list_tables",
      "mcp__supabase-local__list_extensions",
      "mcp__supabase-local__list_migrations",
      "mcp__supabase-local__search_docs",
      "mcp__supabase-local__get_advisors",
      "mcp__supabase-local__query_logs",
      "mcp__supabase-local__generate_typescript_types",
      "mcp__supabase-local__get_project_url"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(npx supabase db push:*)",
      "Bash(supabase db push:*)",
      "Bash(npx supabase migration repair:*)",
      "Bash(supabase migration repair:*)",
      "Bash(npm install:*)",
      "Bash(npm i :*)",
      "PowerShell(git push:*)",
      "PowerShell(npx supabase db push:*)",
      "PowerShell(supabase db push:*)",
      "PowerShell(npx supabase migration repair:*)",
      "PowerShell(supabase migration repair:*)",
      "PowerShell(npm install:*)",
      "PowerShell(npm i :*)",
      "mcp__supabase-local__execute_sql"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.staging)",
      "Read(./.env.production)",
      "Read(./.env.test)",
      "Read(./supabase/.env)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.*.local)",
      "Edit(./.env.production)",
      "Bash(npx supabase link:*)",
      "Bash(supabase link:*)",
      "Bash(npx supabase db push --linked:*)",
      "Bash(supabase db push --linked:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf:*)",
      "Bash(vercel:*)",
      "Bash(npx vercel:*)",
      "Bash(npx supabase login:*)",
      "Bash(npx supabase db dump:*)",
      "Bash(npx supabase db pull:*)",
      "Bash(npx supabase functions deploy:*)",
      "Bash(git -C:*)",
      "Bash(git branch -D:*)",
      "Bash(Remove-Item -Recurse:*)",
      "PowerShell(npx supabase link:*)",
      "PowerShell(supabase link:*)",
      "PowerShell(npx supabase db push --linked:*)",
      "PowerShell(supabase db push --linked:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push -f:*)",
      "PowerShell(rm -rf:*)",
      "PowerShell(vercel:*)",
      "PowerShell(npx vercel:*)",
      "PowerShell(npx supabase login:*)",
      "PowerShell(npx supabase db dump:*)",
      "PowerShell(npx supabase db pull:*)",
      "PowerShell(npx supabase functions deploy:*)",
      "PowerShell(git -C:*)",
      "PowerShell(git branch -D:*)",
      "PowerShell(Remove-Item -Recurse:*)",
      "mcp__supabase-local__apply_migration",
      "mcp__supabase-local__get_publishable_keys"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-migrations.mjs\""
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit.mjs\"",
            "timeout": 300
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.mjs\""
          }
        ]
      }
    ]
  }
}
