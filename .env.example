# Variables de entorno para DESARROLLO LOCAL. Copiá este archivo a .env.local (que nunca se sube).
# Los valores salen de `npx supabase status` con Supabase local prendido.
# Nunca pongas acá claves de staging ni de producción, ni la service_role de ningún ambiente.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Clave pública ("Publishable key" / anon) de Supabase LOCAL.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
